{
  "name": "ai-product-engineering-ii",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --parallel --filter \"./apps/*\" run dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:platform": "pnpm --filter @repo/platform dev",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
